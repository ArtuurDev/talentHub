generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  TALENT
  RECRUITER
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  password  String
  userType  UserType
  createdAt DateTime @default(now())
  updatedAt DateTime?

  @@map("users")
}

model Session {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  refreshToken   String   @unique
  createdAt      DateTime @default(now())
  expiresAt      DateTime?
  lastAccessedAt DateTime?

  @@map("sessions")
}
